{
  "comments": {
    "blockComment": [
      "{{--",
      "--}}"
    ]
  },
  "brackets": [
    [
      "{{",
      "}}"
    ],
    [
      "{!!",
      "!!}"
    ],
    [
      "<",
      ">"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{{",
      "close": " }}"
    },
    {
      "open": "{!!",
      "close": " !!}"
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    }
  ],
  "surroundingPairs": [
    [
      "{{",
      "}}"
    ],
    [
      "{!!",
      "!!}"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*@(section|if|foreach|forelse|for|while|go|else|elseif|empty)\\b",
    "decreaseIndentPattern": "^\\s*@(endsection|endif|endforeach|endforelse|endfor|endwhile|endgo|else|elseif|empty)\\b"
  }
}
