{
  "name": "arandu",
  "displayName": "Arandu",
  "description": "Kyse language intelligence and project navigation for Arandu.",
  "version": "0.1.3",
  "preview": true,
  "publisher": "arandu-io",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/arandu-io/vscode-arandu.git"
  },
  "bugs": {
    "url": "https://github.com/arandu-io/vscode-arandu/issues"
  },
  "homepage": "https://github.com/arandu-io/vscode-arandu",
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:kyse",
    "onView:arandu.projectMap",
    "onView:arandu.development",
    "workspaceContains:**/arandu.toml"
  ],
  "scripts": {
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --legal-comments=eof --outfile=dist/extension.js",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE.md",
    "README.md",
    "dist/extension.js",
    "images/activity.svg",
    "images/icon.png",
    "language-configuration.json",
    "snippets/kyse.json",
    "syntaxes/kyse.tmLanguage.json"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "arandu",
    "go",
    "htmx",
    "kyse",
    "templates"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The Project Map and language server start after the workspace is trusted.",
      "restrictedConfigurations": [
        "arandu.aru.path"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Aru reads an Arandu project from the local filesystem."
    }
  },
  "dependencies": {
    "vscode-languageclient": "10.1.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "contributes": {
    "configuration": {
      "title": "Arandu",
      "properties": {
        "arandu.aru.path": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Absolute path to the Aru executable. Leave empty to search PATH and Homebrew."
        }
      }
    },
    "commands": [
      {
        "command": "arandu.project.select",
        "title": "Select Project",
        "category": "Arandu",
        "icon": "$(root-folder)"
      },
      {
        "command": "arandu.projectMap.refresh",
        "title": "Refresh Project Map",
        "category": "Arandu",
        "icon": "$(refresh)"
      },
      {
        "command": "arandu.languageServer.restart",
        "title": "Restart Language Server",
        "category": "Arandu",
        "icon": "$(debug-restart)"
      },
      {
        "command": "arandu.aru.configure",
        "title": "Configure Aru Path",
        "category": "Arandu"
      },
      {
        "command": "arandu.dev.start",
        "title": "Start Development Server",
        "category": "Arandu",
        "icon": "$(play)"
      },
      {
        "command": "arandu.dev.stop",
        "title": "Stop Development Server",
        "category": "Arandu",
        "icon": "$(debug-stop)"
      },
      {
        "command": "arandu.dev.restart",
        "title": "Restart Development Server",
        "category": "Arandu",
        "icon": "$(debug-restart)"
      },
      {
        "command": "arandu.doctor.run",
        "title": "Run Doctor",
        "category": "Arandu"
      },
      {
        "command": "arandu.aru.updateWithHomebrew",
        "title": "Update with Homebrew",
        "category": "Arandu"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "arandu",
          "title": "Arandu",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "arandu": [
        {
          "id": "arandu.projectMap",
          "name": "Project Map",
          "contextualTitle": "Arandu Project Map"
        },
        {
          "id": "arandu.development",
          "name": "Development",
          "contextualTitle": "Arandu Development"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "arandu.development",
        "contents": "Choose the Arandu project used by Project Map, Doctor, and Development.\n[Select Project](command:arandu.project.select)",
        "when": "!arandu.project.selected"
      },
      {
        "view": "arandu.development",
        "contents": "Start the development server or inspect the project.\n[Start aru dev](command:arandu.dev.start)\n[Run Doctor](command:arandu.doctor.run)\n[Configure Aru](command:arandu.aru.configure)",
        "when": "arandu.project.selected && !arandu.dev.running"
      },
      {
        "view": "arandu.development",
        "contents": "The development server is running.\n[Stop](command:arandu.dev.stop)\n[Restart](command:arandu.dev.restart)\n[Run Doctor](command:arandu.doctor.run)",
        "when": "arandu.project.selected && arandu.dev.running"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "arandu.project.select",
          "when": "view == arandu.projectMap || view == arandu.development",
          "group": "navigation@1"
        },
        {
          "command": "arandu.projectMap.refresh",
          "when": "view == arandu.projectMap",
          "group": "navigation@2"
        },
        {
          "command": "arandu.languageServer.restart",
          "when": "view == arandu.projectMap",
          "group": "navigation@3"
        },
        {
          "command": "arandu.dev.start",
          "when": "view == arandu.projectMap && arandu.project.selected && !arandu.dev.running",
          "group": "navigation@4"
        },
        {
          "command": "arandu.dev.stop",
          "when": "view == arandu.projectMap && arandu.project.selected && arandu.dev.running",
          "group": "navigation@4"
        },
        {
          "command": "arandu.dev.restart",
          "when": "view == arandu.projectMap && arandu.project.selected && arandu.dev.running",
          "group": "navigation@5"
        }
      ]
    },
    "languages": [
      {
        "id": "kyse",
        "aliases": [
          "Kyse",
          "kyse"
        ],
        "extensions": [
          ".kyse.go"
        ],
        "firstLine": "^//go:build\\s+kyse$",
        "configuration": "language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kyse",
        "scopeName": "source.kyse",
        "path": "syntaxes/kyse.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.go": "go",
          "meta.embedded.expression.go": "go",
          "meta.embedded.html.kyse": "html"
        }
      }
    ],
    "snippets": [
      {
        "language": "kyse",
        "path": "snippets/kyse.json"
      }
    ],
    "configurationDefaults": {
      "[kyse]": {
        "editor.formatOnSave": false,
        "editor.insertSpaces": true,
        "editor.tabSize": 4
      }
    }
  }
}
